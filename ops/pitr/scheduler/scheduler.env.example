# SECURITY-2D-3E1B-3C3-A DORMANT scheduler env EXAMPLE - INACTIVE PLACEHOLDERS ONLY. No secrets here.
# Copy to /etc/pitr/scheduler.env and fill ONLY at Inal-approved activation (Phase 4). Real credentials
# (S3 keys, cipher passphrase) are NEVER placed here - pgBackRest reads those from its own secret env
# (see docs/pitr-policy.md). Thresholds are UNKNOWN until the server is sized; keep REPLACE until then.

# Master dormant gate. MUST stay 0/unset in the repo and CI. Set to 1 only on the real host at activation.
PITR_SCHEDULER_ENABLED=0

# pgBackRest stanza name (non-secret).
PGBACKREST_STANZA=pult

# Monitoring thresholds - placeholders; measured after the server is bought/sized (fail-closed if unset).
PITR_BACKUP_MAX_AGE_SEC=REPLACE      # max age of the last base backup before overdue-alarm
PITR_WAL_MAX_LAG_SEC=REPLACE         # informational; WAL health derives from status.sh continuity
PITR_DISK_MIN_FREE_PCT=REPLACE       # minimum free percent on the PGDATA filesystem
PITR_DEADMAN_WINDOW_SEC=REPLACE      # max age of the success heartbeat before dead-man fires
PITR_HEARTBEAT_FILE=/var/lib/pitr/last-success.epoch
PITR_CMD_TIMEOUT=900                 # bound every pgBackRest invocation

# Retention: dry-run by default; a real expire is Role C only, at activation, with an explicit token.
PITR_RETENTION_ENFORCE=dry-run

# Alert transport - DORMANT. 3C3-A never sends a real alert; keep the placeholder .invalid so notify.sh
# stays log-only. A real webhook/e-mail/SMS transport is added in a separate Inal-approved PR.
ALERT_WEBHOOK=REPLACE.invalid
