# SECURITY-2D-3E1B-3B1 — DISCOVERY-ONLY Dockerfile (TEMPORARY; NOT the final runtime image).
# Purpose: on the pinned PostgreSQL base, discover the exact Alpine release, the resolved
# build-dep and runtime-lib package versions, and the pgBackRest binary's shared-lib closure
# (scanelf/ldd), so the FINAL ops/pitr/Dockerfile can pin every apk package =version-rN.
# It installs build deps by NAME (unversioned) — that is why it is discovery-only and MUST NOT
# survive into the squash-merged result. No secrets printed.
FROM postgres:16-alpine@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777 AS discovery

RUN set -eux; \
    echo "=== ALPINE RELEASE ==="; cat /etc/alpine-release; \
    echo "=== REPOSITORIES ==="; cat /etc/apk/repositories; \
    echo "=== ARCH ==="; apk --print-arch

# Build deps by name (discovery). pgBackRest 2.59 uses meson+ninja. Optional libssh2/libsystemd
# disabled; zstd kept (common compression). yaml/bz2/lz4/openssl/libpq/libxml2/zlib required.
RUN set -eux; apk add --no-cache \
      build-base meson ninja pkgconf pax-utils \
      postgresql-dev openssl-dev zlib-dev lz4-dev libxml2-dev bzip2-dev zstd-dev yaml-dev

ADD --checksum=sha256:faaf8faa14a6392279654ee216a493fcd07b0c513af4b55fe34faec062cb8875 \
    https://github.com/pgbackrest/pgbackrest/releases/download/release/2.59.0/pgbackrest-2.59.0.tar.gz /tmp/pgbr.tgz

RUN set -eux; cd /tmp; tar xzf pgbr.tgz; cd pgbackrest-2.59.0; \
    meson setup build . -Dlibssh2=disabled -Dlibsystemd=disabled; \
    ninja -C build; \
    install -m0755 build/src/pgbackrest /usr/bin/pgbackrest; \
    /usr/bin/pgbackrest version

RUN set -eux; \
    echo "=== PGBACKREST VERSION ==="; /usr/bin/pgbackrest version; \
    echo "=== FILE ==="; file /usr/bin/pgbackrest || true; \
    echo "=== LDD ==="; ldd /usr/bin/pgbackrest || true; \
    echo "=== SCANELF NEEDED ==="; scanelf -n /usr/bin/pgbackrest || true; \
    echo "=== WHO-OWNS EACH LINKED LIB ==="; \
    for l in $(ldd /usr/bin/pgbackrest | awk '{print $3}' | grep '^/'); do apk info --who-owns "$l" 2>/dev/null; done | sort -u; \
    echo "=== INSTALLED PACKAGE VERSIONS (name-version-rN) ==="; \
    apk list --installed 2>/dev/null | awk '{print $1}' | sort
