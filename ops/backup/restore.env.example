# SECURITY-2D-3E1B-3A — RESTORE READER secret contract (placeholders only). Held ONLY by the
# operator running a restore, separately from the backup writer. Never committed.

BACKUP_S3_ENDPOINT_UNUSED=  # restore uses its own read endpoint below
RESTORE_S3_ENDPOINT=https://s3.example-ru-region.selectel.invalid
RESTORE_S3_REGION=
RESTORE_S3_BUCKET=
RESTORE_S3_PROVIDER=Other

# READER credentials: GetObject + HeadObject on the backup prefix, ListBucket (prefix-scoped)
# only if restore-point selection needs it. NO PutObject, NO DeleteObject. Distinct principal
# from the writer.
RESTORE_S3_ACCESS_KEY_ID=
RESTORE_S3_SECRET_ACCESS_KEY=

# age PRIVATE identity file (age1... secret). Required ONLY to decrypt during restore; never
# present on the backup writer, never committed to Git, never a CI fixture.
BACKUP_RESTORE_IDENTITY_FILE=/run/secrets/backup_age_identity

# Which backup object to restore (full object key under the prefix).
RESTORE_OBJECT_KEY=

# Target database — MUST be a NEW empty instance/DB (restore refuses a non-empty target and
# never runs --clean against production).
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD_FILE=/run/secrets/restore_db_password
