# SECURITY-2D-3E1B-3A — BACKUP WRITER secret contract (placeholders only; never commit real
# values). These belong ONLY to the backup runner. The web backend compose service must NOT
# receive any of these, and the backup runner must NOT receive marketplace/provider/JWT/Sentry
# secrets or the restore private identity.

# S3-compatible Object Storage (Selectel). Production endpoint MUST be https:// (TLS verified).
# Bucket lives in a Russian region (152-FZ localization) and, by recommendation, a DIFFERENT
# region than the VDS (cross-region). Public access forbidden; Object Lock recommended (3C gate).
BACKUP_S3_ENDPOINT=https://s3.example-ru-region.selectel.invalid
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=pult/pg
BACKUP_S3_PROVIDER=Other

# WRITER credentials: append-oriented, scoped to this bucket/prefix. Grant PutObject (+
# AbortMultipartUpload) and HeadObject on the prefix only. NO GetObject content, NO
# DeleteObject, NO ListAllMyBuckets, NO lifecycle/Object-Lock admin. (Not "absolutely
# write-only" — it needs HeadObject to verify the uploaded object: append-oriented writer
# with scoped metadata verification.)
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# age PUBLIC recipient only (age1...). The private identity is NOT here and NOT known to the
# writer — it lives only with the restore runner (see restore.env.example).
BACKUP_ENCRYPTION_RECIPIENT=

# Database connection for the least-privilege backup role `pult_backup` (read-only).
PGHOST=postgres
PGPORT=5432
PGDATABASE=business_pult
PGUSER=pult_backup
# Password is read from a file, never an inline env value and never a command-line argument.
PGPASSWORD_FILE=/run/secrets/backup_db_password
