# ═══════════════════════════════════════════════════════════
# ПУЛЬТ — Backend Environment Template
# Copy to .env and fill in real values. Never commit .env.
#
# In production (APP_ENV=production) the app FAILS FAST at startup unless the
# four CRITICAL secrets are set: SECRET_KEY, DATABASE_URL (PostgreSQL),
# CRED_ENC_KEY, SMTP_HOST.
# ═══════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
# Values: development | production

# ── Security (CRITICAL) ──────────────────────────────────────────────────────
SECRET_KEY=change_me_use_openssl_rand_hex_32
# Generate: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database (CRITICAL in production) ────────────────────────────────────────
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./business_pult.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/business_pult
# Apply `alembic upgrade head` on startup (default on). Set 0 for multi-worker
# prod that migrates at deploy time.
AUTO_MIGRATE=1

# ── Credential encryption (CRITICAL in production) ───────────────────────────
# Fernet key (urlsafe base64, 32 bytes) used to encrypt marketplace API tokens
# at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRED_ENC_KEY=

# ── Email / SMTP (CRITICAL in production) ────────────────────────────────────
# Delivers email verification + password-reset links. If SMTP_HOST is empty in
# development the link is logged instead of sent. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
# Production examples:
# FRONTEND_URL=https://pult.yourdomain.com
# API_URL=https://api.yourdomain.com

# ── Error tracking (Sentry, recommended in production) ───────────────────────
# If set, backend errors report to Sentry. If empty, tracking is a no-op.
SENTRY_DSN=

# ── Internal / cron control endpoints ────────────────────────────────────────
# Shared secret for internal-only endpoints (e.g. measurement close-due trigger).
# Empty → those endpoints are fail-closed (reject every caller).
INTERNAL_API_KEY=

# ── Payments (YooKassa) — optional for Advisory MVP ──────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Leave empty to auto-derive from FRONTEND_URL + /payment/result
YOOKASSA_RETURN_URL=

# ── Telegram Bot (optional) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── VK (optional) ────────────────────────────────────────────────────────────
VK_API_TOKEN=

# ── Supplier Verification APIs (optional) ────────────────────────────────────
DGIS_API_KEY=
FNS_API_KEY=

# ── Nano Banana AI — image generation (optional) ─────────────────────────────
NANO_BANANA_API_KEY=

# ── Marketplace Execution Layer (optional; defaults are the real WB/Ozon URLs)─
# Override only for testing against a mock host.
# WB_FEEDBACKS_BASE=https://feedbacks-api.wildberries.ru
# WB_PRICES_BASE=https://discounts-prices-api.wildberries.ru
# WB_CONTENT_BASE=https://content-api.wildberries.ru
# WB_ADVERT_BASE=https://advert-api.wildberries.ru
# WB_STATISTICS_BASE=https://statistics-api.wildberries.ru
# OZON_SELLER_BASE=https://api-seller.ozon.ru
# OZON_PERFORMANCE_BASE=https://api-performance.ozon.ru
# MARKETPLACE_HTTP_TIMEOUT=15.0
# Master switch for the L4 automation scheduler (off by default).
AUTOMATION_ENABLED=0

# ── Redis (optional, reserved for future queue) ──────────────────────────────
REDIS_URL=redis://localhost:6379
