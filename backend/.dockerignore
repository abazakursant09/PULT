# Build context is ./backend (docker-compose.yml), so these paths are relative to backend/.

# Sellers' uploaded CSVs. They are transient by design — consumed at confirm and deleted — and
# must never be baked into an image: `COPY . .` in the Dockerfile would otherwise ship whatever
# happened to be on the building machine's disk into every container built from it.
uploads/

# Local noise that has no business in an image.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.db
*.sqlite3

# SECURITY-2D-3C1 — secrets / VCS / keys must never enter the image via `COPY . .`. .gitignore does NOT
# apply to the Docker build context, so these need their own rule here. (The backend reads config from the
# process environment, not a copied .env, so excluding .env* changes nothing at runtime.)
.env
.env.*
.git
.github
*.pem
*.key
*.p12
*.crt

# Logs / local caches / coverage — build artifacts, never a build input.
*.log
.coverage
.mypy_cache/

# Backups / archives that may sit on a build host — never shipped.
backup*/
*.zip
*.tar
*.tar.gz
*.tgz

# SECURITY-2D-3E1B-3A — never ship dumps/ciphertext/keys into an image context.
*.dump
*.dump.age
*.age
*.pgdump
*.manifest.json
*age-identity*
*.identity

# SECURITY-2D-3E1B-3B1 — never ship PITR repo/WAL/keys into an image context.
pgdata/
pg_wal/
pgbackrest-repo/
spool/
*cipher*pass*
*.s3-secret
